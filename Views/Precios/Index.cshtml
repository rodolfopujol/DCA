@model PreciosDto
@{
    ViewData["Title"] = "Precios";
}
<h2>Precios actuales</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<form method="post" action="@Url.Action("Guardar")">
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Tipo cambio USDT - MXN</label>
            <input asp-for="TipoCambioUsdtMxn" class="form-control" />
        </div>
    </div>
    <h5>Activos</h5>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Moneda</th>
                <th>Precio USDT</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Activos.Count; i++)
            {
                <tr>
                    <td><input asp-for="Activos[i].Moneda" class="form-control" /></td>
                    <td><input asp-for="Activos[i].PrecioUsdt" class="form-control" /></td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-success" type="submit">Guardar</button>
</form>
<form method="post" action="@Url.Action("SimularActualizacion")" class="mt-3">
    <button class="btn btn-secondary" type="submit">Actualizar (simulado)</button>
</form>
