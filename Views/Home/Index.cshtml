@using System.Globalization
@model DashboardDto
@{
    ViewData["Title"] = "Dashboard";
    var culture = new CultureInfo("es-MX");
}

<div class="row g-4 mb-4">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <p class="text-muted mb-1">Total invertido MXN</p>
                    <h4 class="mb-0">@Model.TotalInvertidoMxn.ToString("C2", culture)</h4>
                </div>
                <span class="metric-card-icon"><i class="bi bi-cash-coin"></i></span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <p class="text-muted mb-1">Valor actual MXN</p>
                    <h4 class="mb-0">@Model.ValorActualMxn.ToString("C2", culture)</h4>
                </div>
                <span class="metric-card-icon"><i class="bi bi-graph-up"></i></span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <p class="text-muted mb-1">PnL MXN</p>
                    <h4 class="mb-0 @(Model.PnlMxn >= 0 ? "pnl-positive" : "pnl-negative")">@Model.PnlMxn.ToString("C2", culture)</h4>
                </div>
                <span class="metric-card-icon"><i class="bi bi-currency-exchange"></i></span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <p class="text-muted mb-1">PnL %</p>
                    <h4 class="mb-0 @(Model.PnlPorcentaje >= 0 ? "pnl-positive" : "pnl-negative")">@Model.PnlPorcentaje.ToString("N2", culture) %</h4>
                </div>
                <span class="metric-card-icon"><i class="bi bi-percent"></i></span>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="card-title mb-0">Posiciones</h5>
            <small class="text-muted">Portafolio actual</small>
        </div>
        <a class="btn btn-sm btn-secondary d-flex align-items-center gap-1" href="@Url.Action("Index", "Precios")">
            <i class="bi bi-arrow-repeat"></i> Actualizar
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Ticker</th>
                        <th>Activo</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Precio USDT</th>
                        <th class="text-end">Costo prom. USDT</th>
                        <th class="text-end">Costo prom. MXN</th>
                        <th class="text-end">Invertido USDT</th>
                        <th class="text-end">Invertido MXN</th>
                        <th class="text-end">Valor actual MXN</th>
                        <th class="text-end">PnL MXN</th>
                        <th class="text-end">%PnL</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pos in Model.Posiciones)
                    {
                        var pnlClass = pos.PnlMxn >= 0 ? "pnl-positive" : "pnl-negative";
                        <tr>
                            <td><span class="badge crypto-badge">@pos.Moneda</span></td>
                            <td class="fw-semibold">@pos.Moneda</td>
                            <td class="text-end">@pos.Cantidad.ToString("N6", culture)</td>
                            <td class="text-end">@pos.PrecioActualUsdt.ToString("N2", culture)</td>
                            <td class="text-end">@pos.CostoPromedioUsdt.ToString("N2", culture)</td>
                            <td class="text-end">@pos.CostoPromedioMxn.ToString("N2", culture)</td>
                            <td class="text-end">@pos.TotalInvertidoUsdt.ToString("N2", culture)</td>
                            <td class="text-end">@pos.TotalInvertidoMxn.ToString("C2", culture)</td>
                            <td class="text-end">@pos.ValorActualMxn.ToString("C2", culture)</td>
                            <td class="text-end @pnlClass">@pos.PnlMxn.ToString("C2", culture)</td>
                            <td class="text-end @pnlClass">@pos.PnlPorcentaje.ToString("N2", culture) %</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
