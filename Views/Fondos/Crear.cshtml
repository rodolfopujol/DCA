@model FondoLoteDto
@{
    ViewData["Title"] = "Nuevo lote";
}
<h2>Nuevo lote de fondos</h2>
<form method="post" action="@Url.Action("Crear")">
    <div class="row">
        <div class="col-md-3 mb-3">
            <label class="form-label">Fecha</label>
            <input asp-for="Fecha" type="date" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Moneda fondo</label>
            <input asp-for="MonedaFondo" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Cantidad</label>
            <input asp-for="CantidadInicial" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Tipo cambio MXN</label>
            <input asp-for="TipoCambioMxn" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Nota</label>
        <textarea asp-for="Nota" class="form-control"></textarea>
    </div>
    <button class="btn btn-success" type="submit">Guardar</button>
    <a class="btn btn-secondary" href="@Url.Action("Index")">Cancelar</a>
</form>
