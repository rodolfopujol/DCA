@model FondoLoteDto
@{
    ViewData["Title"] = "Nuevo lote";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10 col-xl-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Nuevo lote de fondos</h5>
                <span class="badge bg-gradient-mxn">MXN</span>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("Crear")" novalidate>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Fecha</label>
                            <input asp-for="Fecha" type="date" class="form-control" placeholder="yyyy-mm-dd" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Moneda fondo</label>
                            <input asp-for="MonedaFondo" class="form-control" placeholder="MXN / USDT" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Cantidad</label>
                            <input asp-for="CantidadInicial" class="form-control" placeholder="0.00" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Tipo cambio MXN</label>
                            <input asp-for="TipoCambioMxn" class="form-control" placeholder="Ej. 17.50" required />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">Nota</label>
                        <textarea asp-for="Nota" class="form-control" rows="3" placeholder="Descripción opcional"></textarea>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button class="btn btn-success" type="submit"><i class="bi bi-check2-circle me-1"></i>Guardar</button>
                        <a class="btn btn-secondary" href="@Url.Action("Index")"><i class="bi bi-x-circle me-1"></i>Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
